<%# Auto Dispatch: send the secret link straight to a recipient (and optionally
    their supervisor) by email and/or SMS when the push is created.

    Rendered outside the "Additional Options" collapse on purpose -- on a phone,
    texting the link is the primary reason to be on this page, so it must be
    reachable without expanding anything. Layout is single-column below the md
    breakpoint and two-column above it. %>
<% if Settings.enable_auto_dispatch && user_signed_in? && action_name != 'edit' %>
  <% sms_enabled = Settings.respond_to?(:enable_sms_dispatch) && Settings.enable_sms_dispatch %>
  <% supervisor_enabled = !Settings.auto_dispatch.respond_to?(:enable_supervisor) || Settings.auto_dispatch.enable_supervisor %>
  <div class="row mb-3">
    <div class="col">
      <div class="card">
        <div class="card-header d-flex align-items-center gap-2">
          <em class="bi bi-send" aria-hidden="true"></em>
          <span><%= _('Send This Secret Link To…') %></span>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="<%= sms_enabled ? 'col-12 col-md-6' : 'col-12' %>">
              <label for="dispatch_emails" class="form-label fw-semibold">
                <em class="bi bi-envelope me-1" aria-hidden="true"></em><%= _('Recipient email') %>
              </label>
              <%= text_field_tag 'dispatch_emails', nil,
                    type: "email",
                    multiple: true,
                    id: "dispatch_emails",
                    class: "form-control form-control-lg",
                    placeholder: _('alice@example.com'),
                    autocomplete: "off",
                    autocapitalize: "off",
                    autocorrect: "off",
                    spellcheck: "false" %>
              <div class="form-text">
                <%= _('Separate multiple addresses with commas. Maximum %{count}.') % { count: Settings.auto_dispatch.max_recipients } %>
              </div>
            </div>

            <% if sms_enabled %>
              <div class="col-12 col-md-6">
                <label for="dispatch_phones" class="form-label fw-semibold">
                  <em class="bi bi-chat-dots me-1" aria-hidden="true"></em><%= _('Recipient mobile (SMS)') %>
                </label>
                <%= text_field_tag 'dispatch_phones', nil,
                      type: "tel",
                      id: "dispatch_phones",
                      class: "form-control form-control-lg",
                      inputmode: "tel",
                      placeholder: _('(555) 123-4567'),
                      autocomplete: "off" %>
                <div class="form-text">
                  <%= _('US numbers may be typed without a country code. Maximum %{count}.') % { count: Settings.auto_dispatch.max_sms_recipients } %>
                </div>
              </div>
            <% end %>
          </div>

          <% if supervisor_enabled %>
            <button type="button"
                    class="btn btn-link btn-sm px-0 mt-3 text-decoration-none"
                    data-bs-toggle="collapse"
                    data-bs-target="#supervisorDispatchCollapse"
                    aria-expanded="false"
                    aria-controls="supervisorDispatchCollapse">
              <em class="bi bi-person-plus me-1" aria-hidden="true"></em><%= _('Also send to a supervisor / manager (optional)') %>
            </button>

            <div class="collapse" id="supervisorDispatchCollapse">
              <div class="row g-3 mt-0">
                <div class="<%= sms_enabled ? 'col-12 col-md-6' : 'col-12' %>">
                  <label for="supervisor_email" class="form-label fw-semibold"><%= _('Supervisor email') %></label>
                  <%= text_field_tag 'supervisor_email', nil,
                        type: "email",
                        id: "supervisor_email",
                        class: "form-control form-control-lg",
                        placeholder: _('manager@example.com'),
                        autocomplete: "off",
                        autocapitalize: "off",
                        autocorrect: "off",
                        spellcheck: "false" %>
                </div>
                <% if sms_enabled %>
                  <div class="col-12 col-md-6">
                    <label for="supervisor_phone" class="form-label fw-semibold"><%= _('Supervisor mobile (SMS)') %></label>
                    <%= text_field_tag 'supervisor_phone', nil,
                          type: "tel",
                          id: "supervisor_phone",
                          class: "form-control form-control-lg",
                          inputmode: "tel",
                          placeholder: _('(555) 987-6543'),
                          autocomplete: "off" %>
                  </div>
                <% end %>
              </div>
              <%# The supervisor opens the same link, so they burn a view too.
                  Saying so here prevents the "my recipient got an expired link"
                  support ticket. %>
              <div class="alert alert-warning d-flex gap-2 mt-3 mb-0 py-2 px-3 small">
                <em class="bi bi-exclamation-triangle flex-shrink-0 mt-1" aria-hidden="true"></em>
                <span><%= _('The supervisor receives the same secret link. Each person who opens it uses one view, so allow enough views for everyone you send to.') %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
